# ============================================================
# GO An Nahl — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# Database
# Local dev: SQLite file (relative path, not absolute — works across machines)
DATABASE_URL=file:./db/custom.db
# Vercel/Production: PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Firebase (also hardcoded in src/lib/firebase-config.ts as fallback — env vars override if set)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# Optional: Firebase Admin SDK (for Firestore server-side access)
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"

# PWA Push Notifications (VAPID keys)
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-88chars
VAPID_PRIVATE_KEY=your-vapid-private-key-44chars
